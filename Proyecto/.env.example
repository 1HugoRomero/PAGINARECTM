# Copia este archivo como .env (NO se sube a GitHub) y completa los valores reales.

# Base de datos oficial (Supabase/PostgreSQL)
DATABASE_URL=
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True

# Inicio de sesión con Google (OAuth 2.0). Se obtienen en Google Cloud Console →
# APIs y servicios → Credenciales → «ID de cliente de OAuth» (tipo «Aplicación web»).
# Sin estos dos valores el botón «Continuar con Google» no aparece.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: URL exacta de retorno registrada en Google (si se omite se usa <dominio>/cuenta/google/retorno/).
GOOGLE_REDIRECT_URI=
